<</Type/StructElem/S/Figure/P 108 0 R/Pg 37 0 R/A[306 0 R 0]/K[4]>>
endobj

217 0 obj
<</Type/StructElem/S/P/P 109 0 R/E("E ISAQUE A AMOU" \311 TIPO DO AMOR DE CRISTO PELA IGREJA. EF\311SIOS 5:25: "MARIDOS, AMAI VOSSAS MULHERES, COMO TAMB\311M CRISTO AMOU A IGREJA E A SI MESMO SE ENTREGOU POR ELA." O AMOR DE CRISTO PELA IGREJA N\303O \311 CONSEQU\312NCIA DO M\311RITO DA IGREJA \204 \311 O FUNDAMENTO DA RELA\307\303O. REBECA N\303O CONQUISTOU O AMOR DE ISAQUE COM SUAS QUALIDADES; ELA CHEGOU, E ELE A AMOU. ASSIM A IGREJA N\303O CONQUISTA O AMOR DE CRISTO \204 ELA \311 RECEBIDA NELE. E A \332LTIMA FRASE \204 "CONSOLOU-SE DEPOIS DA MORTE DE SUA M\303E" \204 APONTA PARA O CONSOLO ESCATOL\323GICO QUE CRISTO TRAR\301: APOCALIPSE 21:4, "ENXUGAR\301 DOS SEUS OLHOS TODA L\301GRIMA, E N\303O HAVER\301 MAIS MORTE, NEM PRANTO, NEM CLAMOR, NEM DOR.")/Pg 38 0 R/K[0]>>
endobj

218 0 obj
<</Type/StructElem/S/P/P 109 0 R/E(GERHARD VON RAD \204 GENESIS \(OTL COMMENTARY\))/Pg 38 0 R/K[1]>>
endobj

219 0 obj
<</Type/StructElem/S/P/P 109 0 R/E("'E ELE A AMOU' \204 COM ESTAS PALAVRAS SIMPLES O NARRADOR ENCERRA UMA DAS HIST\323RIAS MAIS ELABORADAS DO G\312NESIS. TODA A EXTENS\303O DO CAP\315TULO \204 OS CAMELOS, AS ORA\307\325ES, OS PRESENTES, OS DISCURSOS, AS NEGOCIA\307\325ES \204 SERVE PARA PREPARAR ESTE MOMENTO: O AMOR ENTRE O HERDEIRO DA PROMESSA E A MULHER QUE DEUS ESCOLHEU PARA ELE. A BREVIDADE DA CONCLUS\303O \311 UM RECURSO ART\315STICO CONSCIENTE: A M\301XIMA PROFUNDIDADE \311 DITA NA M\301XIMA BREVIDADE.")/Pg 38 0 R/K[2]>>
endobj

220 0 obj
<</Type/StructElem/S/H1/P 109 0 R/T("E ISAQUE A AMOU" \(V.66-67\))/E("E ISAQUE A AMOU" \(V.66-67\))/Pg 38 0 R/K[3]>>
endobj

