222 0 obj
<</Type/StructElem/S/P/P 110 0 R/E(CHARLES HADDON SPURGEON \204 "THE MATCHLESS MARRIAGE" \(1870\))/Pg 39 0 R/K[0]>>
endobj

223 0 obj
<</Type/StructElem/S/P/P 110 0 R/E("'E ISAQUE A AMOU.' N\303O 'A TOLEROU', N\303O 'A ACEITOU', N\303O 'A SUPORTOU'. AMOU. ESTE \311 O AMOR DE CRISTO PELA IGREJA: N\303O UM AMOR DE CONDESCEND\312NCIA, MAS DE DELEITE GENU\315NO. REBECA N\303O PRECISOU CONQUISTAR O AMOR DE ISAQUE \204 ELA CHEGOU E ELE A AMOU. ASSIM CHEGAMOS A CRISTO PELA F\311 \204 E DESCOBRIMOS QUE SOMOS AMADOS ANTES MESMO DE AMARMOS.")/Pg 39 0 R/K[1]>>
endobj

224 0 obj
<</Type/StructElem/S/P/P 110 0 R/E(G\312NESIS 24 \311, NA SUA ESTRUTURA NARRATIVA MAIS PROFUNDA, O EVANGELHO CONTADO COMO UMA HIST\323RIA DE AMOR. )/Pg 39 0 R/K[2]>>
endobj

225 0 obj
<</Type/StructElem/S/P/P 110 0 R/E("PORQUE EU VOS TENHO DADO EM CASAMENTO A UM \332NICO ESPOSO, PARA VOS APRESENTAR COMO UMA VIRGEM PURA A CRISTO." \204 2 COR\315NTIOS 11:2B)/Pg 39 0 R/K[3]>>
endobj

226 0 obj
<</Type/StructElem/S/P/P 110 0 R/E("E VI A SANTA CIDADE, A NOVA JERUSAL\311M, QUE DESCIA DO C\311U, DA PARTE DE DEUS, ADORNADA COMO UMA NOIVA ATAVIADA PARA O SEU ESPOSO." \204 APOCALIPSE 21:2)/Pg 39 0 R/K[4]>>
endobj

227 0 obj
<</Type/StructElem/S/P/P 110 0 R/E(GRAEME GOLDSWORTHY \204 ACCORDING TO PLAN \(1991\))/Pg 39 0 R/K[5]>>
endobj

228 0 obj
<</Type/StructElem/S/P/P 110 0 R/E("G\312NESIS 24 \311 UMA DAS MAIS PERFEITAS PREFIGURA\307\325ES DO PLANO REDENTOR DE DEUS. UM PAI QUE AMA O FILHO ENVIA UM SERVO PARA BUSCAR UMA NOIVA. A NOIVA \311 CHAMADA, ADORNADA E CONDUZIDA. O FILHO A RECEBE E A AMA. ESTA HIST\323RIA N\303O \311 APENAS BELA \204 ELA \311 O ESQUEMA NARRATIVO DO EVANGELHO. E O EVANGELHO N\303O \311 UMA HIST\323RIA INVENTADA SOBRE DEUS \204 \311 A HIST\323RIA QUE DEUS INSCREVEU NO TECIDO DA REALIDADE DESDE A CRIA\307\303O.")/Pg 39 0 R/K[6]>>
endobj

