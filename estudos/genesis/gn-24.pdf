endobj

205 0 obj
<</Type/StructElem/S/P/P 106 0 R/E("ISAQUE MEDITANDO NO CAMPO AO ENTARDECER \311 A IMAGEM DO CRENTE QUE AGUARDA EM ORA\307\303O E CONTEMPLA\307\303O A REALIZA\307\303O DA PROMESSA DE DEUS. ELE N\303O FOI BUSCAR A NOIVA \204 A NOIVA VEM A ELE, TRAZIDA PELO SERVO. ESTA PASSIVIDADE N\303O \311 INDIFEREN\307A; \311 A POSTURA DE QUEM SABE QUE AS PROMESSAS DE DEUS CHEGAM NO TEMPO CERTO, SEM QUE PRECISEMOS FOR\307\301-LAS.")/Pg 35 0 R/K[1]>>
endobj

206 0 obj
<</Type/StructElem/S/P/P 106 0 R/E(H. C. LEUPOLD \204 EXPOSITION OF GENESIS \(VOL. 2\))/Pg 35 0 R/K[2]>>
endobj

207 0 obj
<</Type/StructElem/S/P/P 106 0 R/E("O V\311U DE REBECA AO VER ISAQUE \311 UM GESTO DE RECONHECIMENTO E DE CONSAGRA\307\303O. ELA QUE DISSE 'IREI' AGORA DIZ COM O GESTO DO V\311U: 'CHEGUEI, E SOU TUA.' O NOIVADO QUE COME\307OU COM O 'IREI' JUNTO \300 TENDA DA FAM\315LIA SE CONSUMA COM O V\311U NO CAMPO DO NEGUEV.")/Pg 35 0 R/K[3]>>
endobj

208 0 obj
<</Type/StructElem/S/H1/P 106 0 R/T("E ISAQUE SAIU A MEDITAR NO CAMPO AO CAIR DA TARDE" \(V.61-65\))/E("E ISAQUE SAIU A MEDITAR NO CAMPO AO CAIR DA TARDE" \(V.61-65\))/Pg 35 0 R/K[4]>>
