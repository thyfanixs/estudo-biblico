194 0 obj
<</Type/StructElem/S/P/P 102 0 R/E(O "IREI" DE REBECA \311 TIPO DA RESPOSTA LIVRE DA IGREJA AO CHAMADO DE CRISTO. A NOIVA DE CRISTO N\303O \311 COAGIDA \204 ELA \311 CONVIDADA E RESPONDE LIVREMENTE. APOCALIPSE 22:17: "O ESP\315RITO E A NOIVA DIZEM: VEM!" A IGREJA N\303O \311 FOR\307ADA AO CASAMENTO COM O FILHO \204 ELA DESEJA, ESCOLHE E DECLARA: "IREI." ASSIM COMO REBECA DEIXA CASA, FAM\315LIA E TERRA NATAL PARA IR AO ENCONTRO DE UM NOIVO QUE AINDA N\303O VIU, O CRENTE DEIXA O MUNDO ANTIGO PARA IR AO ENCONTRO DO CRISTO QUE AINDA N\303O VIU COM OLHOS F\315SICOS, MAS CUJA REALIDADE \311 GARANTIDA PELO TESTEMUNHO DO ESP\315RITO \(1 PE 1:8: "NO QUAL, N\303O O TENDO VISTO, O AMAIS; E NELE, N\303O VENDO, MAS CRENDO, VOS ALEGRAREIS COM ALEGRIA INEF\301VEL E CHEIA DE GL\323RIA"\).)/Pg 31 0 R/K[0]>>
endobj

195 0 obj
<</Type/StructElem/S/P/P 102 0 R/E(CHARLES HADDON SPURGEON \204 SERMON ON GENESIS 24 \(METROPOLITAN TABERNACLE, 1869\))/Pg 31 0 R/K[1]>>
endobj

196 0 obj
<</Type/StructElem/S/P/P 102 0 R/E("'IREI.' UMA PALAVRA. MAS QUE PALAVRA! ELA CONT\311M TUDO: F\311 SEM VER, AMOR SEM CONHECER, OBEDI\312NCIA SEM PERGUNTAR O CAMINHO. REBECA NUNCA VIU ISAQUE. ELA VAI AO ENCONTRO DE UM NOIVO QUE S\323 CONHECE PELO TESTEMUNHO DO SERVO. ESTA \311 EXATAMENTE A POSI\307\303O DO CRENTE: AMAMOS A CRISTO SEM O TER VISTO, CONFIAMOS NO TESTEMUNHO DO ESP\315RITO, E DIZEMOS 'IREI' \204 RUMO A UMA ETERNIDADE CUJO ROSTO AINDA N\303O CONTEMPLAMOS.")/Pg 31 0 R/K[2]>>
endobj

197 0 obj
<</Type/StructElem/S/H1/P 102 0 R/T("DE DEUS SAIU ESTE NEG\323CIO" \(V.50-60\))/E("DE DEUS SAIU ESTE NEG\323CIO" \(V.50-60\))/Pg 31 0 R/K[3]>>
endobj

